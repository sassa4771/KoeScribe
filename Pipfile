[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true     # ← CPU 版はこれだけで十分

[scripts]
init-dict = "python -m unidic download"

[packages]
# ──────────── PyTorch ファミリ（CPU ビルド）────────────
torch        = "==2.3.0"
torchvision  = "==0.18.0"
torchaudio   = "==2.3.0"

# ──────────── 音声 & 日本語処理 ────────────
openai-whisper   = "*"
ffmpeg-python    = "*"
numpy            = "<2"          # PyTorch 2.3 は NumPy 2.0 非対応
janome           = "*"
mecab-python3    = "*"
unidic-lite      = "*"
unidic           = "*"

[requires]
python_version = "3.12"

[dev-packages]
ipykernel = "*"
